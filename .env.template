# Environment template — documents every variable the app reads.
#
# Files Vite actually loads (first match wins per mode):
#   .env             committed defaults for local development
#   .env.local       git-ignored personal overrides
#   .env.production  git-ignored production URLs; CI generates it from repo
#                    secrets (SpicyPizza/create-envfile), never commit it
#
# Vite inlines VITE_APP_* at BUILD time — change a value, rebuild/restart dev.
# The app origin (VITE_APP_DOMAIN) must be registered in the Keycloak client's
# valid redirect URIs, web origins and allowed origins, or login/silent-SSO
# will silently fail (the provider's 15s watchdog then renders logged-out).

# Public origin of THIS app (Keycloak redirects + /silent-check-sso.html)
VITE_APP_DOMAIN=http://localhost:3000

# Keycloak server — realm "app", client "frontend" (see .credentials.template)
VITE_APP_KEYCLOAK_URL=http://localhost:8090

# Backend base for REST /coroutine/*, GraphQL /graphql and SSE /update/user
VITE_APP_BACKEND_URL=http://localhost:8080

# Production example (softeno.dev deployment):
# VITE_APP_DOMAIN=https://app.softeno.dev
# VITE_APP_KEYCLOAK_URL=https://auth.softeno.dev
# VITE_APP_BACKEND_URL=https://api.softeno.dev/spring-reactive-template
