# Local development credentials TEMPLATE - copy to `.credentials` and fill in.
# `.credentials` is git-ignored and must NEVER be committed. Agents: read the
# real values from `.credentials`, never invent or print the password.
# Targets the local Keycloak from .env (VITE_APP_KEYCLOAK_URL), not production.

APP_URL=http://localhost:3000
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=app
KEYCLOAK_CLIENT_ID=frontend
BACKEND_URL=http://localhost:8080

# Realm user - either username or email can be used to sign in.
USERNAME=<realm user username>
EMAIL=<realm user email>
PASSWORD=<realm user password>

# NOTE: if the password ends in punctuation (e.g. "?"), it IS part of the
#       password - type it exactly.
# NOTE: the local Keycloak master-realm admin may not be the default
#       admin/admin; do not assume kcadm.sh works with that pair.
